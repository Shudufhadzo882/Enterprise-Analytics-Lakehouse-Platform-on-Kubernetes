FROM python:3.10-slim

WORKDIR /usr/app/dbt

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    dbt-core \
    dbt-duckdb \
    dbt-snowflake \
    dbt-redshift

COPY src/dbt /usr/app/dbt

ENV DBT_PROFILES_DIR=/usr/app/dbt

ENTRYPOINT ["dbt"]
CMD ["run"]
